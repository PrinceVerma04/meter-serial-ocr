# ============================================================
#  Meter serial OCR — keep the repo to code + docs + results + the deploy package.
#  Images and model binaries stay local (too large for GitHub); the label CSVs and
#  datasets/README.md + models/README.md say what they contain.
# ============================================================

# --- python environments ---
.venv/
**/venv/

# --- data and models: images and model binaries stay local; READMEs and ground-truth label files are tracked ---
datasets/**
!datasets/**/
!datasets/README.md
!datasets/**/labels.csv
!datasets/v1_v2_labels/ground_truth.csv
models/**
!models/**/
!models/README.md
quantization/compat_env/inference_*/

# --- raw test-image folders and pages that embed images (repo is public) ---
new testing data 4 nov/
docs/resume_explained/

# --- training work dirs (checkpoints, generated lists) ---
training/output_*/

# --- archives (deploy/meterocr_ptq_py38_v3.zip and docs/*.zip stay local) ---
*.zip

# --- logs (except the training logs, kept as a record) ---
*.log
!training/logs/v4_train.log

# --- python / editor / os cruft ---
__pycache__/
*.pyc
*.pyo
.~lock.*#
.DS_Store
.ipynb_checkpoints/
.claude/
*.tmp
