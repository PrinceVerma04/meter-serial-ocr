# ============================================================
#  Meter serial OCR — keep the repo to code + docs + results + the deploy package.
#  Data and model binaries stay local (too large for GitHub); see datasets/README.md
#  and models/README.md for what they contain.
# ============================================================

# --- python environments ---
.venv/
**/venv/

# --- data and models (local only) ---
datasets/
models/
quantization/compat_env/inference_*/

# --- training work dirs (checkpoints, generated lists) ---
training/output_*/

# --- archives (deploy/meterocr_ptq_py38_v3.zip and docs/*.zip stay local) ---
*.zip

# --- logs (except the v4 training log, kept as a record) ---
*.log
!training/logs/*.log

# --- python / editor / os cruft ---
__pycache__/
*.pyc
*.pyo
.~lock.*#
.DS_Store
.ipynb_checkpoints/
.claude/
*.tmp
